# Copy this file to .env and fill in real values. .env is gitignored --
# never commit real secrets or credentials.
#
# Settings are read automatically from .env by backend/app/config.py
# (pydantic-settings, env_file=".env") -- you don't need to export these by
# hand or pass them inline on the uvicorn command line.

# --- DRES ---------------------------------------------------------------

# Base URL of the DRES server.
#   local mock DRES (tools/mock_dres.py):  http://localhost:8090
#   a real local DRES instance:            http://localhost:8088
#   inside the docker-compose network:     http://dres:8080
DRES_BASE_URL=http://localhost:8090

# ID of the running evaluation/run in DRES (find it in the DRES admin UI).
# Leave unset/empty for local dev with no evaluation configured -- the app
# then reports "no evaluation" instead of erroring.
DRES_EVALUATION_ID=mock-eval

# Timeout (seconds) for calls to DRES.
# DRES_TIMEOUT_S=5.0

# --- Session / security ---------------------------------------------------

# Random secret used to sign this app's own session cookie (never sent to
# DRES). MUST be set to a real random value in production.
SESSION_SECRET=dev-secret

# true in production (served over HTTPS via Caddy). Set to false only for
# local dev over plain http://127.0.0.1 -- otherwise browsers silently drop
# the cookie.
SESSION_COOKIE_SECURE=false

# --- Request limits (optional, defaults are usually fine) ----------------

# MAX_K=100
# RATE_LIMIT_PER_MIN=30
